DATA_SOURCE=mock
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opsional, hanya DATA_SOURCE=mock: 1 = semua kotak grid tanpa data gambut (cek lapisan "Lahan gambut" nonaktif).
# Mulai ulang server setelah mengubahnya.
MOCK_TANPA_GAMBUT=

# Opsional: URL style MapLibre untuk peta dasar (default OpenFreeMap positron/dark, tanpa API key)
NEXT_PUBLIC_MAP_STYLE_LIGHT=
NEXT_PUBLIC_MAP_STYLE_DARK=
